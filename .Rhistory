library(rclsp)
set.seed(123456789L)
m <- 20L
p <- 20L
idx <- sample.int(m * p, size = 40L, replace = TRUE)
M <- diag(m * p)[idx, , drop = FALSE]
X_true <- matrix(abs(rnorm(m * p)), nrow = m, ncol = p)
b_row <- rowSums(X_true)
b_col <- colSums(X_true)
b_val <- as.vector(t(X_true))[idx]
b <- matrix(c(b_row, b_col, b_val), ncol = 1L)
fit <- rclsp::clsp(
problem = "ap",
C       = NULL,
S       = NULL,
M       = M,
b       = b,
m       = m,
p       = p,
r       = 2L,
final   = TRUE,
alpha   = 1.0
)
devtools::build()
